# ── Discord ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token
# Optional: register slash commands instantly to one guild during development.
# Leave unset to register globally (propagation can take up to ~1 hour).
DISCORD_GUILD_ID=your_server_id

# ── Database / Cache ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://nigerian:nigerian@localhost:5432/nigerian_bot
REDIS_URL=redis://localhost:6379

# ── External services ─────────────────────────────────────────────────────
SONAR_URL=http://localhost:9000
SONAR_TOKEN=your_sonar_token
RADAR_URL=http://localhost:8080
RADAR_TOKEN=your_radar_token

# ── Music (Phase 6) ───────────────────────────────────────────────────────
MUSIC_MOUNT_PATH=/mnt/music

# ── API / Auth ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change_me_to_a_long_random_secret
API_KEY=your_api_key

# ── Worker ────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECS=30

# ── Logging ───────────────────────────────────────────────────────────────
# Standard tracing filter, e.g. `info`, `debug`, `bot=debug,info`.
RUST_LOG=info

# ── Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
