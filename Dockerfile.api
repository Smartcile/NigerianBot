# syntax=docker/dockerfile:1
#
# API service image. Lives at the repo ROOT (Portainer mis-resolves Dockerfiles
# in subdirectories). Build context is the repo root so the whole workspace and
# the migrations directory are available.

# ─── Build stage ───────────────────────────────────────────────────────────
FROM rust:1-bookworm AS builder
WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY common ./common
COPY bot ./bot
COPY api ./api
COPY scheduler ./scheduler
COPY worker ./worker
# Embedded into the binary at build time via sqlx::migrate!.
COPY migrations ./migrations

RUN cargo build --release -p api

# ─── Runtime stage ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/nigerian-api /usr/local/bin/nigerian-api

RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/nigerian-api"]
