# syntax=docker/dockerfile:1
#
# API service image. Lives at the repo ROOT (Portainer mis-resolves Dockerfiles
# in subdirectories). Builds the React dashboard (Node stage), then the Rust API
# which serves the built static files. Uses cargo-chef to cache Rust deps.

# ─── Frontend (React/Vite) ──────────────────────────────────────────────────
FROM node:20-bookworm-slim AS frontend
WORKDIR /dash
COPY dashboard/package.json ./
RUN npm install
COPY dashboard/ ./
RUN npm run build

FROM rust:1-bookworm AS chef
RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
# Cached unless Cargo.toml/Cargo.lock change.
RUN cargo chef cook --release --recipe-path recipe.json -p api
COPY . .
RUN cargo build --release -p api

# ─── Runtime stage ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/nigerian-api /usr/local/bin/nigerian-api
# Built dashboard, served by the API at "/".
COPY --from=frontend /dash/dist /app/static

# Seed /downloads owned by appuser so a FRESH named volume inherits write
# permission regardless of whether the API or the worker initializes it. The API
# mounts it read-only; the worker writes here.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /downloads \
    && chown 10001:10001 /downloads
USER appuser

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/nigerian-api"]
