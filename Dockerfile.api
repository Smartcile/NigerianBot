# syntax=docker/dockerfile:1
#
# API service image. Lives at the repo ROOT (Portainer mis-resolves Dockerfiles
# in subdirectories). Uses cargo-chef to cache the dependency compile layer.

FROM rust:1-bookworm AS chef
RUN cargo install cargo-chef --locked
WORKDIR /app

FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS builder
COPY --from=planner /app/recipe.json recipe.json
# Cached unless Cargo.toml/Cargo.lock change.
RUN cargo chef cook --release --recipe-path recipe.json -p api
COPY . .
RUN cargo build --release -p api

# ─── Runtime stage ─────────────────────────────────────────────────────────
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/nigerian-api /usr/local/bin/nigerian-api

RUN useradd --create-home --uid 10001 appuser
USER appuser

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/nigerian-api"]
