# ── Discord ───────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_bot_token
# Optional: register slash commands instantly to one guild during development.
# Leave unset to register globally (propagation can take up to ~1 hour).
DISCORD_GUILD_ID=your_server_id
# Optional voice-pool bots: extra Discord apps (each invited to the server) that
# add simultaneous voice slots. Leave unset for a single bot.
# DISCORD_TOKEN_2=second_bot_token
# DISCORD_TOKEN_3=third_bot_token
# Comma-separated Discord user ids always treated as Admin (server owner is too).
ADMIN_DISCORD_IDS=

# ── Database / Cache ──────────────────────────────────────────────────────
# In the Portainer stack these POSTGRES_* values configure the postgres service,
# and DATABASE_URL is assembled from them automatically. For local dev, set
# DATABASE_URL directly to your own Postgres.
POSTGRES_USER=nigerian
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=nigerian_bot
DATABASE_URL=postgresql://nigerian:change_me_to_a_strong_password@localhost:5432/nigerian_bot
REDIS_URL=redis://localhost:6379

# ── Media services (Sonarr / Radarr) ──────────────────────────────────────
# URLs must be reachable from the bot container. API key: in each app under
# Settings → General → API Key.
SONARR_URL=http://localhost:8989
SONARR_API_KEY=your_sonarr_api_key
RADARR_URL=http://localhost:7878
RADARR_API_KEY=your_radarr_api_key

# ── Music (Phase 6) ───────────────────────────────────────────────────────
# MUSIC_MOUNT_PATH is the folder INSIDE the container where music files are read.
# MUSIC_HOST_PATH (used by docker-compose) is the folder on the SERVER that gets
# mounted there read-only. In the stack, leave MUSIC_MOUNT_PATH=/music.
MUSIC_MOUNT_PATH=/music
MUSIC_HOST_PATH=/srv/music

# ── Downloads (Vimeo / YouTube / any URL) ─────────────────────────────────
# Where the worker writes finished files INSIDE the container. The API serves
# this same directory read-only at /media. In the stack, leave DOWNLOADS_PATH.
DOWNLOADS_PATH=/downloads
# Host folder (on the server) mounted at /downloads. Point this at a folder
# Sonarr/Radarr also mount so they can import. The app runs as uid 10001, so:
#   mkdir -p /srv/nigerianbot/downloads && chown 10001:10001 /srv/nigerianbot/downloads
DOWNLOADS_HOST_PATH=./downloads
# How Sonarr/Radarr SEE the shared downloads folder (for the Import button).
# If they mount the same host folder at /downloads, leave these as-is.
SONARR_IMPORT_PATH=/downloads
RADARR_IMPORT_PATH=/downloads
# Optional: public URL of the API, used to build clickable file links in
# Discord/Telegram notifications (e.g. https://bot.example.com).
PUBLIC_BASE_URL=
# Optional: post to a Discord channel when a download finishes (channel
# settings → Integrations → Webhooks → New Webhook → Copy URL).
DISCORD_NOTIFY_WEBHOOK=
# Cookies for login-gated sites (e.g. some Vimeo videos) are uploaded from the
# web GUI (Downloads tab → "Upload cookies"), stored in the `cookies` volume.
# Export a Netscape-format cookies.txt with a browser extension, or on a desktop:
#   yt-dlp --cookies-from-browser chrome --cookies cookies.txt --skip-download <url>
# Advanced only: override the stored path (default /cookies/cookies.txt).
YTDLP_COOKIES_FILE=
# Optional: route yt-dlp through a proxy/VPN. Needed for region-locked sites
# like Tubi (US-only). Point at a proxy container reachable from this one, e.g.
#   socks5://gluetun:1080   or   http://gluetun:8888
# Note: this applies to ALL downloads; if Vimeo cookies were minted on your home
# IP, keep this unset or make sure you browse Vimeo from the same exit too.
YTDLP_PROXY=

# ── Telegram ──────────────────────────────────────────────────────────────
# Bot token from @BotFather. Required to run the telegram service.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Chat id to notify on finished downloads; DM the bot first and check the id.
TELEGRAM_CHAT_ID=
# Comma-separated Telegram user ids always treated as Admin (bootstrap).
TELEGRAM_ADMIN_IDS=

# ── API / Auth ────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=change_me_to_a_long_random_secret
# Dashboard sign-in PIN. Seeds the PIN on first run; you're asked to change it
# on first sign-in (stored bcrypt-hashed in the database).
DASHBOARD_PIN=1234
# Optional: alternative credential for scripts / API clients (leave blank to disable).
API_KEY=

# ── Worker ────────────────────────────────────────────────────────────────
WORKER_POLL_INTERVAL_SECS=30

# ── Logging ───────────────────────────────────────────────────────────────
# Standard tracing filter, e.g. `info`, `debug`, `bot=debug,info`.
RUST_LOG=info

# ── Dashboard ─────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
